COMPOSE_PROJECT_NAME=clickhouse
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
TZ=UTC

# 宿主机绑定地址：默认仅本机；局域网访问可改为 0.0.0.0（务必配合防火墙）
CLICKHOUSE_BIND=127.0.0.1

# 宿主机映射端口（容器内固定 HTTP 8123、原生 9000）
# 原生宿主机默认 19000，避免与 rustfs（S3 API 9000）冲突
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=19000

# 账户与库名（首次初始化用户配置时生效；已有数据卷时改密码需自行在库内处理）
CLICKHOUSE_USER=default
CLICKHOUSE_DB=default
# 务必改成强密码，勿提交 .env（未设密码时官方镜像会禁用 default 的网络访问）
CLICKHOUSE_PASSWORD=请改成强密码

# 允许用 SQL 管理用户（1=开，0=关）
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
