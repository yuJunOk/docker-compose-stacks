COMPOSE_PROJECT_NAME=clickhouse-1s3r
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
ZOOKEEPER_IMAGE=zookeeper:3.9
TZ=UTC

# 宿主机绑定地址：默认仅本机；局域网访问可改为 0.0.0.0（务必配合防火墙）
CLICKHOUSE_BIND=127.0.0.1

# 三节点 HTTP / 原生端口（容器内仍为 8123 / 9000）
CH_HTTP_PORT_1=18124
CH_NATIVE_PORT_1=19001
CH_HTTP_PORT_2=18125
CH_NATIVE_PORT_2=19002
CH_HTTP_PORT_3=18126
CH_NATIVE_PORT_3=19003

# ZooKeeper 客户端端口（可选调试；副本协调走容器网络）
ZK_CLIENT_PORT_1=2181
ZK_CLIENT_PORT_2=2182
ZK_CLIENT_PORT_3=2183

# 账户与库名（三节点共用；首次初始化时生效）
CLICKHOUSE_USER=default
CLICKHOUSE_DB=default
# 务必改成强密码，勿提交 .env
CLICKHOUSE_PASSWORD=请改成强密码

# 允许用 SQL 管理用户（1=开，0=关）
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
