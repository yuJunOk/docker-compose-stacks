COMPOSE_PROJECT_NAME=svn-server
SVN_IMAGE=garethflowers/svn-server:1.8.1
TZ=UTC

# 宿主机绑定地址与端口（容器内固定 3690）
# 默认仅本机可连；需要局域网客户端访问时改为 0.0.0.0，并配合防火墙与强密码
SVN_BIND=127.0.0.1
SVN_PORT=3690

# 首次启动自动创建的仓库名与管理员账号（仅首次建仓时生效）
# 仓库名仅用字母、数字、-、_，勿用中文、空格或特殊字符
SVN_REPO=repo
SVN_USERNAME=svnuser
# 必填：务必改成强密码，勿提交 .env
# 该密码会明文写入数据卷内仓库的 conf/passwd；避免使用 # ; 与换行
SVN_PASSWORD=请改成强密码
